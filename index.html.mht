========================================================= */

function updateHud(){

  if(!$("clues"))
    return;


  $("clues").textContent =
    save.clues;


  $("dreamBar").style.width =
    (
      save.clues / 5 * 100
    ) + "%";


  $("goal").textContent =
    nights[
      save.night-1
    ].goal;


  $("zone").textContent =
    "Ø´Ø¨ " +
    save.night +
    " Â· " +
