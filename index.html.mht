    .answer-box{
        background:white;
    }
}

<a class="user-mention notranslate" data-hovercard-type="organization" data-hovercard-url="/orgs/media/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/media" aria-keyshortcuts="Alt+ArrowUp">@media</a>(max-width:600px){
