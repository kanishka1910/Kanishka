      <p dir="auto">using UnityEngine;<br>
using UnityEngine.UI;</p>
<p dir="auto">public class CarHUDManager : MonoBehaviour<br>
{<br>
[Header("References")]<br>
public Rigidbody carRigidbody; // Car ka Rigidbody yahan dalein<br>
public Text speedText;         // Speed dikhane ke liye UI Text<br>
public Slider fuelSlider;      // Fuel bar ke liye UI Slider</p>
<pre class="notranslate"><code class="notranslate">[Header("Fuel Settings")]
public float maxFuel = 100f;
private float currentFuel;
public float fuelDrainRate = 2f; // Har second kitna fuel khatam hoga

void Start()
{
    currentFuel = maxFuel;
    if (fuelSlider != null)
    {
        fuelSlider.maxValue = maxFuel;
        fuelSlider.value = currentFuel;
    }
}

void Update()
{
    UpdateSpeedometer();
    UpdateFuelMeter();
}

void UpdateSpeedometer()
{
    if (carRigidbody != null &amp;&amp; speedText != null)
    {
        // Rigidbody ki velocity se speed nikal kar km/h mein convert karein
        float speed = carRigidbody.velocity.magnitude * 3.6f; 
        speedText.text = Mathf.Round(speed) + " km/h";
    }
}

void UpdateFuelMeter()
{
    if (currentFuel &gt; 0)
    {
        // Gadi chalne par fuel kam hoga
        currentFuel -= fuelDrainRate * Time.deltaTime;
        
        if (fuelSlider != null)
        {
            fuelSlider.value = currentFuel;
        }
    }
    else
    {
        // Fuel khatam hone par kya hona chahiye (Jaise game over ya gadi ruk jana)
        Debug.Log("Fuel Finished!");
        // Yahan aap car ki speed zero kar sakte hain
        if (carRigidbody != null)
        {
            carRigidbody.velocity = Vector3.zero;
        }
    }
}

// Agar game mein fuel refill karna ho toh yeh function call kar sakte hain
public void RefillFuel(float amount)
{
    currentFuel = Mathf.Clamp(currentFuel + amount, 0f, maxFuel);
}
</code></pre>
<p dir="auto">}</p>
