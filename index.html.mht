  overflow:hidden;
}

.scene canvas{
  width:100%;
  height:100%;
  display:block;
  touch-action:none;
}

.hud{
  position:absolute;
  inset:10px 10px auto;

  display:grid;
  grid-template-columns:1fr auto;
  gap:8px;

  pointer-events:none;
}

.hudbox{
  background:#06091dcc;
  border:1px solid #fff2;
  border-radius:14px;
  padding:8px 10px;
}

.objective{
  grid-column:1/-1;
}

.bar{
