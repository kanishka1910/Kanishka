    &lt;p style="margin: 6px 0 0 0; font-size: 12px;"&gt;HEALTH&lt;/p&gt;
    &lt;div class="bar-container"&gt;&lt;div id="health-bar"&gt;&lt;/div&gt;&lt;/div&gt;
    
    &lt;p style="margin: 0; font-size: 12px;"&gt;ARMOR&lt;/p&gt;
    &lt;div class="bar-container"&gt;&lt;div id="armor-bar"&gt;&lt;/div&gt;&lt;/div&gt;

    &lt;div class="hint"&gt;
        &lt;strong&gt;WASD:&lt;/strong&gt; Move / Drive&lt;br&gt;
        &lt;strong&gt;[F]:&lt;/strong&gt; Enter / Exit Vehicle&lt;br&gt;
        &lt;strong&gt;[Space / Click]:&lt;/strong&gt; Fire Weapon&lt;br&gt;
        &lt;strong&gt;[K]:&lt;/strong&gt; Commit Crime (+1â˜…)
    &lt;/div&gt;
&lt;/div&gt;

&lt;!-- Mini-Map Canvas --&gt;
&lt;div id="radar-container"&gt;
    &lt;canvas id="radar" width="150" height="150"&gt;&lt;/canvas&gt;
&lt;/div&gt;

&lt;script&gt;
    // --- 1. SCENE SETUP ---
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0d14);
    scene.fog = new THREE.FogExp2(0x0a0d14, 0.012);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.3);
    scene.add(ambientLight);

    const sun = new THREE.DirectionalLight(0xffffff, 0.7);
    sun.position.set(100, 150, 50);
    sun.castShadow = true;
    scene.add(sun);

    // --- 2. CITY GENERATION ---
    const mapSize = 500;
    const blockSize = 32;
    const roadWidth = 18;
    const buildings = [];

    const groundGeo = new THREE.PlaneGeometry(mapSize, mapSize);
    const groundMat = new THREE.MeshStandardMaterial({ color: 0x1d1e22 });
    const ground = new THREE.Mesh(groundGeo, groundMat);
    ground.rotation.x = -Math.PI / 2;
    ground.receiveShadow = true;
    scene.add(ground);

    const step = blockSize + roadWidth;
    const halfMap = mapSize / 2;

    for (let x = -halfMap + step / 2; x &lt; halfMap; x += step) {
        for (let z = -halfMap + step / 2; z &lt; halfMap; z += step) {
            if (Math.abs(x) &lt; 30 &amp;&amp; Math.abs(z) &lt; 30) continue;

            const height = Math.floor(Math.random() * 40) + 15;
            const buildingGeo = new THREE.BoxGeometry(blockSize, height, blockSize);
            const buildingMat = new THREE.MeshStandardMaterial({
                color: Math.random() &gt; 0.5 ? 0x2c323d : 0x1e222b,
                roughness: 0.8
            });

            const b = new THREE.Mesh(buildingGeo, buildingMat);
            b.position.set(x, height / 2, z);
            b.castShadow = true;
            b.receiveShadow = true;
            scene.add(b);

            buildings.push({
                x: x, z: z,
                minX: x - blockSize / 2 - 1.2,
                maxX: x + blockSize / 2 + 1.2,
                minZ: z - blockSize / 2 - 1.2,
                maxZ: z + blockSize / 2 + 1.2
            });
        }
    }

    // --- 3. ENTITIES &amp; COMBAT SYSTEM ---
    const keys = {};
    let state = 'foot';
    let wantedLevel = 0;
    let health = 100;
    let armor = 100;

    // Player
    const player = new THREE.Mesh(
        new THREE.BoxGeometry(1, 2, 1),
        new THREE.MeshStandardMaterial({ color: 0x0088ff })
    );
    player.position.set(0, 1, 0);
    player.castShadow = true;
    scene.add(player);

    // Player Vehicle
    const playerCar = new THREE.Mesh(
        new THREE.BoxGeometry(2.4, 1.2, 4.8),
        new THREE.MeshStandardMaterial({ color: 0x00ff66, roughness: 0.3 })
    );
    playerCar.position.set(8, 0.6, 8);
    playerCar.castShadow = true;
    scene.add(playerCar);

    let speed = 0;
    const maxSpeed = 0.85;
    const acceleration = 0.022;
    const friction = 0.965;

    // Police, Helicopters &amp; Combat
    const cops = [];
    const bullets = [];
    const particles = [];
    let copSpawnTimer = 0;
    let sirenTick = 0;
    let shootCooldown = 0;

    // Chopper
    let chopper = null;
    let spotlight = null;

    // --- 4. CONTROLS ---
    window.addEventListener('keydown', (e) =&gt; {
        const k = e.key.toLowerCase();
        keys[k] = true;
        if (k === 'f') toggleVehicle();
        if (k === 'k') raiseWantedLevel();
        if (e.code === 'Space') fireBullet();
    });

    window.addEventListener('keyup', (e) =&gt; {
        keys[e.key.toLowerCase()] = false;
    });

    window.addEventListener('mousedown', (e) =&gt; {
        if (e.button === 0) fireBullet();
    });

    function toggleVehicle() {
        if (state === 'foot') {
            if (player.position.distanceTo(playerCar.position) &lt; 4.5) {
                state = 'driving';
                player.visible = false;
                document.getElementById('status').innerText = 'Driving Getaway Car';
            }
        } else {
            state = 'foot';
            player.visible = true;
            player.position.copy(playerCar.position).add(new THREE.Vector3(2.5, 0.4, 0));
            document.getElementById('status').innerText = 'On Foot';
        }
    }

    function raiseWantedLevel() {
        if (wantedLevel &lt; 5) setWanted(wantedLevel + 1);
    }

    function setWanted(level) {
        wantedLevel = level;
        const stars = 'â˜…'.repeat(level) + 'â˜†'.repeat(5 - level);
        document.getElementById('wanted').innerText = stars;

        if (wantedLevel === 5 &amp;&amp; !chopper) spawnChopper();
    }

    function applyDamage(amount) {
        if (armor &gt; 0) {
            armor -= amount;
            if (armor &lt; 0) {
                health += armor; // Overflow to health
                armor = 0;
            }
        } else {
            health -= amount;
        }

        health = Math.max(0, health);
        document.getElementById('health-bar').style.width = health + '%';
        document.getElementById('armor-bar').style.width = armor + '%';

        if (health &lt;= 0) {
            alert("WASTED! You died from your injuries.");
            resetGame();
        }
    }

    // --- 5. COMBAT &amp; HELICOPTER MECHANICS ---
    function fireBullet() {
        if (shootCooldown &gt; 0) return;
        shootCooldown = 10;

        if (wantedLevel === 0) setWanted(1);

        const bullet = new THREE.Mesh(
            new THREE.SphereGeometry(0.25, 8, 8),
            new THREE.MeshBasicMaterial({ color: 0xffff00 })
        );

        let origin = new THREE.Vector3();
        let dir = new THREE.Vector3();

        if (state === 'foot') {
            origin.copy(player.position).add(new THREE.Vector3(0, 0.5, 0));
            dir.set(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), player.rotation.y);
        } else {
            origin.copy(playerCar.position).add(new THREE.Vector3(0, 0.8, 0));
            dir.set(0, 0, -1).applyAxisAngle(new THREE.Vector3(0, 1, 0), playerCar.rotation.y);
        }

        bullet.position.copy(origin);
        scene.add(bullet);

        bullets.push({ mesh: bullet, direction: dir, life: 60 });
    }

    function createExplosion(pos) {
        for (let i = 0; i &lt; 20; i++) {
            const p = new THREE.Mesh(
                new THREE.BoxGeometry(0.4, 0.4, 0.4),
                new THREE.MeshBasicMaterial({ color: Math.random() &gt; 0.5 ? 0xff4400 : 0xffcc00 })
            );
            p.position.copy(pos);
            scene.add(p);

            particles.push({
                mesh: p,
                velocity: new THREE.Vector3(
                    (Math.random() - 0.5) * 0.8,
                    Math.random() * 0.6,
                    (Math.random() - 0.5) * 0.8
                ),
                life: 25
            });
        }
    }

    function spawnChopper() {
        chopper = new THREE.Group();

        const bodyMat = new THREE.MeshStandardMaterial({ color: 0x111111 });
        const body = new THREE.Mesh(new THREE.BoxGeometry(3, 2, 7), bodyMat);
        chopper.add(body);

        // Rotor
        const rotor = new THREE.Mesh(
            new THREE.BoxGeometry(10, 0.1, 0.6),
            new THREE.MeshBasicMaterial({ color: 0x333333 })
        );
        rotor.position.y = 1.2;
        chopper.add(rotor);

        // Spotlight
        spotlight = new THREE.SpotLight(0xffffff, 2, 80, Math.PI / 6, 0.5);
        spotlight.castShadow = true;
        chopper.add(spotlight);
        spotlight.target = state === 'driving' ? playerCar : player;

        chopper.position.set(0, 35, 0);
        scene.add(chopper);
    }

    function spawnPoliceUnit() {
        const targetPos = state === 'driving' ? playerCar.position : player.position;
        const isHeavy = wantedLevel === 5;
        
        const group = new THREE.Group();
        const size = isHeavy ? [2.8, 1.8, 5.5] : [2.4, 1.3, 4.8];
        const body = new THREE.Mesh(
            new THREE.BoxGeometry(...size),
            new THREE.MeshStandardMaterial({ color: isHeavy ? 0x050505 : 0x111111 })
        );
        body.position.y = size[1] / 2;
        group.add(body);

        const angle = Math.random() * Math.PI * 2;
        const dist = 70 + Math.random() * 30;
        group.position.set(targetPos.x + Math.cos(angle) * dist, 0, targetPos.z + Math.sin(angle) * dist);

        scene.add(group);

        cops.push({
            mesh: group,
            speed: isHeavy ? 0.38 : 0.28 + (wantedLevel * 0.02),
            hp: isHeavy ? 3 : 1
        });
    }

    function updatePoliceAndCombat() {
        if (shootCooldown &gt; 0) shootCooldown--;

        // Bullets
        for (let i = bullets.length - 1; i &gt;= 0; i--) {
            const b = bullets[i];
            b.mesh.position.addScaledVector(b.direction, 2.0);
            b.life--;

            let hit = false;
            for (let j = cops.length - 1; j &gt;= 0; j--) {
                const cop = cops[j];
                if (b.mesh.position.distanceTo(cop.mesh.position) &lt; 2.5) {
                    cop.hp--;
                    hit = true;
                    if (cop.hp &lt;= 0) {
                        createExplosion(cop.mesh.position);
                        scene.remove(cop.mesh);
                        cops.splice(j, 1);
                        raiseWantedLevel();
                    }
                    break;
                }
            }

            if (hit || b.life &lt;= 0) {
                scene.remove(b.mesh);
                bullets.splice(i, 1);
            }
        }

        // Particles
        for (let i = particles.length - 1; i &gt;= 0; i--) {
            const p = particles[i];
            p.mesh.position.add(p.velocity);
            p.life--;
            if (p.life &lt;= 0) {
                scene.remove(p.mesh);
                particles.splice(i, 1);
            }
        }

        // Chopper System
        if (chopper) {
            const targetPos = state === 'driving' ? playerCar.position : player.position;
            chopper.position.x += (targetPos.x - chopper.position.x) * 0.02;
            chopper.position.z += (targetPos.z - chopper.position.z) * 0.02;
            chopper.children[1].rotation.y += 0.4; // Rotor Spin
        }

        if (wantedLevel === 0) return;

        // Siren Screen Flashing
        sirenTick += 0.15;
        const overlay = document.getElementById('siren-overlay');
        overlay.style.border = Math.sin(sirenTick) &gt; 0 ? "8px solid rgba(255, 0, 0, 0.4)" : "8px solid rgba(0, 100, 255, 0.4)";

        // Cop Spawner
        const maxCops = wantedLevel === 5 ? 8 : wantedLevel * 1.5;
        copSpawnTimer++;
        if (cops.length &lt; maxCops &amp;&amp; copSpawnTimer &gt; 80) {
            spawnPoliceUnit();
            copSpawnTimer = 0;
        }

        const targetPos = state === 'driving' ? playerCar.position : player.position;

        for (let i = cops.length - 1; i &gt;= 0; i--) {
            const cop = cops[i];
            cop.mesh.lookAt(targetPos.x, cop.mesh.position.y, targetPos.z);
            
            const dist = cop.mesh.position.distanceTo(targetPos);

            if (dist &gt; 3.0) {
                cop.mesh.translateZ(cop.speed);
            } else {
                // Ramming Damage
                applyDamage(0.5);
            }
        }
    }

    // --- 6. RADAR MINI-MAP RENDERER ---
    const radarCanvas = document.getElementById('radar');
    const ctx = radarCanvas.getContext('2d');

    function drawRadar() {
        ctx.clearRect(0, 0, 150, 150);

        const center = 75;
        const scale = 0.6; // Radar zoom factor
        const activePos = state === 'driving' ? playerCar.position : player.position;

        // 1. Draw Buildings
        ctx.fillStyle = "#444955";
        buildings.forEach(b =&gt; {
            const relX = (b.x - activePos.x) * scale;
            const relZ = (b.z - activePos.z) * scale;
            if (Math.abs(relX) &lt; 70 &amp;&amp; Math.abs(relZ) &lt; 70) {
                ctx.fillRect(center + relX - (blockSize * scale) / 2, center + relZ - (blockSize * scale) / 2, blockSize * scale, blockSize * scale);
            }
        });

        // 2. Draw Police Blips
        ctx.fillStyle = "#ff2222";
        cops.forEach(c =&gt; {
            const relX = (c.mesh.position.x - activePos.x) * scale;
            const relZ = (c.mesh.position.z - activePos.z) * scale;
            ctx.beginPath();
            ctx.arc(center + relX, center + relZ, 3.5, 0, Math.PI * 2);
            ctx.fill();
        });

        // 3. Draw Player Blip
        ctx.fillStyle = state === 'driving' ? "#00ff66" : "#0088ff";
        ctx.beginPath();
        ctx.arc(center, center, 4, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = "#ffffff";
        ctx.stroke();
    }

    function resetGame() {
        cops.forEach(c =&gt; scene.remove(c.mesh));
        bullets.forEach(b =&gt; scene.remove(b.mesh));
        particles.forEach(p =&gt; scene.remove(p.mesh));
        if (chopper) scene.remove(chopper);

        cops.length = 0;
        bullets.length = 0;
        particles.length = 0;
        chopper = null;

        health = 100;
        armor = 100;
        document.getElementById('health-bar').style.width = '100%';
        document.getElementById('armor-bar').style.width = '100%';
        document.getElementById('siren-overlay').style.border = "none";

        setWanted(0);
        if (state === 'driving') toggleVehicle();
        player.position.set(0, 1, 0);
        playerCar.position.set(8, 0.6, 8);
        speed = 0;
    }

    // --- 7. COLLISION &amp; GAME LOOP ---
    function checkCollisions(newPos) {
        for (let b of buildings) {
            if (newPos.x &gt; b.minX &amp;&amp; newPos.x &lt; b.maxX &amp;&amp;
                newPos.z &gt; b.minZ &amp;&amp; newPos.z &lt; b.maxZ) {
                return true;
            }
        }
        return false;
    }

    function animate() {
        requestAnimationFrame(animate);

        // On Foot Controls
        if (state === 'foot') {
            const moveSpeed = 0.22;
            const nextPos = player.position.clone();

            if (keys['w']) nextPos.z -= moveSpeed;
            if (keys['s']) nextPos.z += moveSpeed;
            if (keys['a']) nextPos.x -= moveSpeed;
            if (keys['d']) nextPos.x += moveSpeed;

            if (keys['w'] || keys['s'] || keys['a'] || keys['d']) {
                player.rotation.y = Math.atan2(nextPos.x - player.position.x, nextPos.z - player.position.z) + Math.PI;
            }

            if (!checkCollisions(nextPos)) {
                player.position.copy(nextPos);
            }

            camera.position.set(player.position.x, player.position.y + 12, player.position.z + 18);
            camera.lookAt(player.position);
        }

        // Driving Controls
        if (state === 'driving') {
            if (keys['w']) speed = Math.min(speed + acceleration, maxSpeed);
            if (keys['s']) speed = Math.max(speed - acceleration, -maxSpeed / 2);

            if (keys['a']) playerCar.rotation.y += 0.042 * (speed &gt;= 0 ? 1 : -1);
            if (keys['d']) playerCar.rotation.y -= 0.042 * (speed &gt;= 0 ? 1 : -1);
