&lt;style&gt;
:root{
    --primary:#1a237e;
    --primary2:#283593;
    --accent:#ff6f00;
    --success:#2e7d32;
    --danger:#c62828;
    --light:#f5f5f5;
    --hint:#e8eaf6;
    --white:#fff;
    --text:#212121;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:"Segoe UI",Tahoma,Geneva,Verdana,sans-serif;
    background:linear-gradient(135deg,#e8eaf6,#c5cae9);
    min-height:100vh;
    padding:20px;
    color:var(--text);
    line-height:1.6;
}

.container{
    max-width:900px;
    margin:auto;
}

/* HEADER */

header{
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    color:white;
    padding:35px 25px;
    border-radius:18px 18px 0 0;
    text-align:center;
    position:relative;
    overflow:hidden;
}

header:before{
    content:"ğŸ”";
    position:absolute;
    font-size:130px;
    opacity:.08;
    right:-10px;
    top:-25px;
    transform:rotate(15deg);
}

header h1{
    font-size:2em;
    margin-bottom:8px;
    position:relative;
}

header p{
    opacity:.9;
    font-size:1.1em;
    position:relative;
}

.badge{
    display:inline-block;
    background:var(--accent);
    color:white;
    padding:5px 14px;
    border-radius:20px;
    font-size:.85em;
    margin:10px 4px 0;
    font-weight:bold;
}

/* TOOLBAR */

.toolbar{
    background:white;
    padding:16px 22px;
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    align-items:center;
    border-bottom:3px solid var(--accent);
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.toolbar label{
    font-weight:600;
    color:var(--primary);
}

.toolbar input{
    flex:1;
    min-width:180px;
    padding:10px 14px;
    border:2px solid #c5cae9;
    border-radius:8px;
    font-size:1em;
}

.toolbar input:focus{
    outline:none;
    border-color:var(--primary);
}

.toolbar button{
    padding:10px 16px;
    border:0;
    border-radius:8px;
    cursor:pointer;
    font-weight:600;
    transition:.2s;
}

.toolbar button:hover{
    transform:translateY(-2px);
}

.btn-print{
    background:var(--primary);
    color:white;
}

.btn-clear{
    background:#ffe0e0;
    color:var(--danger);
}

.timer{
    background:#fff3e0;
    color:#e65100;
    padding:9px 13px;
    border-radius:8px;
    font-weight:bold;
    white-space:nowrap;
}

.timer.warning{
    background:#ffebee;
    color:var(--danger);
    animation:pulse 1s infinite;
}

<a class="user-mention notranslate" data-hovercard-type="organization" data-hovercard-url="/orgs/Keyframes/hovercard" data-octo-click="hovercard-link-click" data-octo-dimensions="link_type:self" href="https://github.com/Keyframes" aria-keyshortcuts="Alt+ArrowUp">@Keyframes</a> pulse{
    50%{opacity:.5}
}

.save-status{
    color:var(--success);
    font-size:.85em;
    font-weight:bold;
    opacity:0;
    transition:.3s;
}

.save-status.show{
    opacity:1;
}

/* INTRO */

.intro{
    background:white;
    padding:28px;
    border-left:5px solid var(--accent);
}

.intro h2{
    color:var(--primary);
    margin-bottom:10px;
}

.intro p{
    margin-bottom:10px;
}

.intro ul{
    padding-left:22px;
}

.highlight{
    background:#fff8e1;
    padding:14px 16px;
    border-radius:8px;
    margin-top:15px;
    border-left:3px solid var(--accent);
}

/* TASKS */

.task-card{
    background:white;
    margin:20px 0;
    border-radius:12px;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
    overflow:hidden;
    transition:.2s;
}

.task-card:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 24px rgba(0,0,0,.12);
}

.task-header{
    background:var(--primary);
    color:white;
    padding:16px 22px;
    display:flex;
    align-items:center;
    gap:12px;
}

.num{
    background:var(--accent);
    width:38px;
    height:38px;
    border-radius:50%;
    display:flex;
    justify-content:center;
    align-items:center;
    font-weight:bold;
    flex-shrink:0;
}

.task-header h3{
    font-size:1.1em;
}

.task-body{
    padding:22px;
}

.scenario{
    background:var(--light);
    padding:14px 18px;
    border-radius:8px;
    border-left:4px solid var(--primary);
    margin-bottom:15px;
}

.task-body p{
    margin-bottom:12px;
}

/* HINT */

.hint-toggle{
    width:100%;
    background:var(--hint);
    border:0;
    padding:11px 16px;
    border-radius:8px;
    cursor:pointer;
    color:var(--primary);
    font-weight:bold;
    text-align:left;
    font-size:.95em;
}

.hint-toggle:hover{
    background:#d0d5f0;
}

.hint-content{
    display:none;
    background:#f3f4ff;
    padding:15px 18px;
    border-left:4px solid var(--accent);
    border-radius:0 0 8px 8px;
}

.hint-content.show{
    display:block;
}

.hint-content ul{
    padding-left:20px;
}

/* ANSWERS */

.answer-box{
    background:#e8f5e9;
    border:2px dashed var(--success);
    padding:15px 18px;
    border-radius:8px;
    margin-top:15px;
}

.answer-box label{
    display:block;
    font-weight:bold;
    color:var(--success);
    margin-bottom:7px;
}

textarea{
    width:100%;
    min-height:100px;
    padding:12px;
    border:2px solid #a5d6a7;
    border-radius:8px;
    resize:vertical;
    font-family:inherit;
    font-size:1em;
    line-height:1.5;
}

textarea:focus{
    outline:none;
    border-color:var(--success);
    box-shadow:0 0 0 3px rgba(46,125,50,.15);
}

.small-input{
    min-height:55px;
}

/* TAGS */

.tag{
    display:inline-block;
    background:#e3f2fd;
    color:var(--primary);
    padding:2px 9px;
    border-radius:12px;
    font-size:.8em;
    font-weight:600;
}

/* FINAL */

.final-challenge{
    background:linear-gradient(135deg,var(--primary),var(--primary2));
    color:white;
    border-radius:16px;
    padding:30px;
    margin-top:30px;
    text-align:center;
}

.final-challenge h2{
    margin-bottom:10px;
}

.final-challenge p{
    margin-bottom:15px;
}

.final-challenge .answer-box{
    background:rgba(255,255,255,.95);
    text-align:left;
}

/* FOOTER */

footer{
    text-align:center;
    color:#666;
    font-size:.85em;
    padding:25px 10px;
}

/* PROGRESS */

.progress-box{
    background:white;
    padding:14px 22px;
    text-align:center;
}

.progress-text{
    font-weight:bold;
    color:var(--primary);
    margin-bottom:7px;
}

.progress{
    height:10px;
    background:#e0e0e0;
    border-radius:20px;
    overflow:hidden;
}

.progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,var(--accent),#ff9800);
    transition:.3s;
}

/* PRINT */

