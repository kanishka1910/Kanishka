    }
  &lt;/style&gt;


<div dir="auto">
  <h2 dir="auto">ğŸ“ Location Demo</h2>
  
  <div id="user-content-phonesection" dir="auto">
    
<pre class="notranslate"><code class="notranslate">&lt;br&gt;

&lt;button onclick="sendOTP()"&gt;
  Send OTP
&lt;/button&gt;
</code></pre>
  </div>
  
  <div id="user-content-otpsection" dir="auto">
<pre class="notranslate"><code class="notranslate">&lt;p&gt;Demo OTP: &lt;b&gt;123456&lt;/b&gt;&lt;/p&gt;

&lt;input
  type="number"
  id="otp"
  placeholder="Enter OTP"
&gt;

&lt;br&gt;

&lt;button onclick="verifyOTP()"&gt;
  Verify OTP
&lt;/button&gt;
</code></pre>
  </div>
  
  <div id="user-content-locationsection" dir="auto">
<pre class="notranslate"><code class="notranslate">&lt;p&gt;OTP verified successfully.&lt;/p&gt;

&lt;button onclick="getLocation()"&gt;
  ğŸ“ Share My Location
&lt;/button&gt;

&lt;p id="status"&gt;&lt;/p&gt;
&lt;p id="coordinates"&gt;&lt;/p&gt;

&lt;a
  id="mapLink"
  href="#"
  target="_blank"
  style="display:none;"
&gt;
  ğŸ—ºï¸ Open in Google Maps
&lt;/a&gt;
</code></pre>
  </div>
</div>
&lt;script&gt;

function sendOTP() {

  const phone = document.getElementById("phone").value;

  if (phone.length &lt; 10) {
    alert("Please enter a valid mobile number.");
    return;
  }

  // DEMO ONLY
  // Real SMS OTP requires a backend/SMS service.

  alert("Demo OTP sent: 123456");

  document.getElementById("phoneSection").style.display = "none";
  document.getElementById("otpSection").style.display = "block";
}


function verifyOTP() {

  const otp = document.getElementById("otp").value;

  if (otp === "123456") {

    document.getElementById("otpSection").style.display = "none";
    document.getElementById("locationSection").style.display = "block";

  } else {

    alert("Incorrect OTP.");

  }
}


function getLocation() {

  const status = document.getElementById("status");
  const coordinates = document.getElementById("coordinates");
  const mapLink = document.getElementById("mapLink");

  if (!navigator.geolocation) {

    status.innerText =
      "âŒ This browser does not support location.";

    return;
  }

  status.innerText =
    "Requesting location permission...";

  navigator.geolocation.getCurrentPosition(

    function(position) {

      const latitude =
        position.coords.latitude;

      const longitude =
        position.coords.longitude;

      coordinates.innerHTML =
        "Latitude: " + latitude +
        "<br>" +
        "Longitude: " + longitude;

      mapLink.href =
        "https://www.google.com/maps?q=" +
        latitude + "," + longitude;

      mapLink.style.display = "inline-block";

      status.innerText =
        "âœ… Location received.";

    },

    function(error) {

      status.innerText =
        "âŒ Location permission was denied or unavailable.";

    },

    {
      enableHighAccuracy: true,
      timeout: 10000,
      maximumAge: 0
    }

  );
}

&lt;/script&gt;


