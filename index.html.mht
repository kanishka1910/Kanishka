.error {
  color: red;
  animation: blink .15s infinite;
}

@keyframes blink {
  50% { opacity: .2; }
}
</code></pre>
  &lt;/style&gt;


<div id="user-content-screen" dir="auto"></div>
&lt;script&gt;
const screen = document.getElementById("screen");

const messages = [
  "[SYSTEM] Initializing...",
  "[WARNING] Unknown process detected",
  "[ERROR] Memory integrity check failed",
  "[ERROR] Unexpected JavaScript exception",
  "[SYSTEM] Attempting recovery...",
  "[SYSTEM] SIMULATION COMPLETE"
];

let i = 0;

function simulate() {
  if (i &lt; messages.length) {
    const line = document.createElement("div");
    line.textContent = messages[i];

    if (messages[i].includes("ERROR")) {
      line.className = "error";
    }

    screen.appendChild(line);
    i++;
    setTimeout(simulate, 700);
  }
}

simulate();
&lt;/script&gt;


