  const length =
    Math.hypot(x,y);


  if(length){

    x/=length;
    y/=length;


    const speed =
      (speedBoost ? 3.6 : 2.2) * dt;


    player.position.x +=
      x * speed;


    player.position.z +=
      y * speed;


    save.x =
