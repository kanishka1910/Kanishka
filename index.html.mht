<pre class="notranslate"><code class="notranslate">&lt;div id="siren-overlay"&gt;&lt;/div&gt;

&lt;div id="ui"&gt;
    &lt;h2 style="margin: 0 0 10px 0; font-size: 18px;"&gt;GTA Web Engine&lt;/h2&gt;
