========================================================= */

const joystick =
  $("joy");

const knob =
  $("knob");


function moveJoystick(event){

  const rect =
    joystick.getBoundingClientRect();


  const centerX =
    rect.left +
    rect.width/2;


  const centerY =
    rect.top +
    rect.height/2;


  let dx =
    event.clientX -
    centerX;


  let dy =
    event.clientY -
    centerY;


  const length =
    Math.hypot(dx,dy) || 1;


  const max =
    rect.width*.34;


  const amount =
    Math.min(
      length,
      max
    );


  joy.x =
    dx / length;


  joy.y =
    dy / length;


  knob.style.transform =
    `translate(
      ${joy.x*amount}px,
      ${joy.y*amount}px
    )`;

}


joystick.onpointerdown =
  event =&gt; {

    joystick.setPointerCapture(
      event.pointerId
    );

    moveJoystick(event);

  };


joystick.onpointermove =
  event =&gt; {

    if(event.buttons)
      moveJoystick(event);

  };


joystick.onpointerup =
  () =&gt; {

    joy.x=0;
