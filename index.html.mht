<p dir="auto">let targetX = 0;<br>
let targetY = 0;</p>
<p dir="auto">let currentX = 0;<br>
let currentY = 0;</p>
<p dir="auto">function moveEffect(x, y) {</p>
<p dir="auto">const rect = scene.getBoundingClientRect();</p>
<p dir="auto">const centerX = rect.left + rect.width / 2;<br>
const centerY = rect.top + rect.height / 2;</p>
<p dir="auto">targetX = ((x - centerX) / rect.width) * 12;<br>
targetY = ((y - centerY) / rect.height) * 12;<br>
}</p>
<p dir="auto">document.addEventListener("mousemove", e =&gt; {<br>
moveEffect(e.clientX, e.clientY);<br>
});</p>
<p dir="auto">document.addEventListener("touchmove", e =&gt; {</p>
<p dir="auto">if (!e.touches.length) return;</p>
<p dir="auto">moveEffect(<br>
