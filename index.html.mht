  border:1px solid #ffffff19;

  pointer-events:auto;
  position:relative;
}

.knob{
  width:50%;
  aspect-ratio:1;

  position:absolute;
  left:25%;
  top:25%;

  border-radius:50%;
  background:#7657ff99;
}

.actionsPad{
  display:grid;
  grid-template-columns:repeat(2,64px);
  gap:9px;

  pointer-events:auto;
}

.actionsPad button{
  border-radius:50%;
  background:#0c1236dd;
  border:1px solid #ffffff18;
}

.actionsPad .wide{
  grid-column:1/-1;
  border-radius:16px;
  color:var(--gold);
}

.list{
